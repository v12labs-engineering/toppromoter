# Browser-visible application URLs
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:9000
NEXT_PUBLIC_AFFILIATE_SITE_URL=http://127.0.0.1:9001
NEXT_PUBLIC_DOCS_SITE_URL=http://127.0.0.1:9002

# Supabase. The anon key is browser-visible; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_STORAGE_URL=http://127.0.0.1:54321/storage/v1/object/public/

# 32-byte key encoded as 64 hexadecimal characters. Server-only.
PAYMENT_INTEGRATION_DECRYPT_KEY=replace-with-64-hex-characters

# Stripe (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_WEBHOOK_SECRET=
NEXT_PUBLIC_CLIENT_ID=

# Email providers (optional)
SIB_API_KEY=
MAILERLITE_KEY=

# Monitoring and event logging (optional, server-only unless named NEXT_PUBLIC)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
LOGSNAG_TOKEN=
